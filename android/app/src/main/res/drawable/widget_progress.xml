<?xml version="1.0" encoding="utf-8"?>
<!--
  The same bar the app draws, inverted for a dark surface: a solid fill on a
  track that is the accent showing through. One colour, one direction, no
  gradient — see ScoreBar in lib/ui/kit.dart.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Track -->
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="3dp" />
            <solid android:color="@color/widget_track" />
        </shape>
    </item>

    <!-- Fill -->
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="3dp" />
                <solid android:color="@color/widget_on_accent" />
            </shape>
        </clip>
    </item>
</layer-list>
